  catalogo: {fileID: 11400000, guid: bc5c22cdc15746546871562596a6b6fe, type: 2}
  bases:
  - nombre: "Expedici\xF3n E-4 (provisional)"
    descripcion: "\xDAnica base de esta prueba. Bloque sin acabado para comprobar
      espacio, accesos y montaje de m\xF3dulos. Masa estructural: la del casco del
      cat\xE1logo; la ampliaci\xF3n del bloque a\xFAn no tiene balance de masa (PROVISIONAL)."
    tripulantes: 4
    alturaLibreM: 3.4
    cascoInferiorY: -1
    cascoSuperiorY: 3.9
    grosorMuroM: 0.2
    estadoAltura: 1
    casco:
    - nombre: Proa (pilotaje)
      semiAncho: 4.6
      zMin: 1.3
      zMax: 5.5
      estado: 0
    - nombre: Salas laterales
      semiAncho: 5.8
      zMin: -4.5
      zMax: 1.3
      estado: 0
    - nombre: Centro (esclusa y carga)
      semiAncho: 4.4
      zMin: -9
      zMax: -4.5
      estado: 1
    - nombre: "Popa (ingenier\xEDa)"
      semiAncho: 4.1
      zMin: -14.8
      zMax: -9
      estado: 0
    zonas:
    - nombre: Pilotaje
      tipo: 0
      xMin: -4
      xMax: 4
      zMin: 1.5
      zMax: 5
      estado: 0
      nota: Cabina actual; consola v0 en (0; 0; 3,30) y asiento en z 2,95.
    - nombre: Pasillo
      tipo: 4
      xMin: -1.5
      xMax: 1.5
      zMin: -9
      zMax: 1.5
      estado: 1
      nota: Antes 2,4 m de ancho; propuesto 3,0 m para cruzarse flotando.
    - nombre: Comunicaciones
      tipo: 3
      xMin: 1.7
      xMax: 5.4
      zMin: -4.1
      zMax: 0.7
      estado: 1
      nota: "Antes 3,8 \xD7 4,0 m; propuesto 3,7 \xD7 4,8 m dentro de la envolvente."
    - nombre: Ciencia
      tipo: 2
      xMin: -5.4
      xMax: -1.7
      zMin: -4.1
      zMax: 0.7
      estado: 1
      nota: "Sim\xE9trica de Comunicaciones."
    - nombre: Esclusa
      tipo: 5
      xMin: 1.7
      xMax: 4
      zMin: -7.6
      zMax: -5.1
      estado: 2
      nota: "Nueva. Escotilla exterior de 1,4 \xD7 2,0 m en el costado derecho."
    - nombre: Reserva de carga
      tipo: 6
      xMin: -4
      xMax: -1.7
      zMin: -7.6
      zMax: -5.1
      estado: 3
      nota: Solo volumen reservado para estiba interior; abierta al pasillo.
    - nombre: "Ingenier\xEDa"
      tipo: 1
      xMin: -3.7
      xMax: 3.7
      zMin: -14.2
      zMax: -9.2
      estado: 0
      nota: Sala actual; la abertura al pasillo pasa a 3,0 m.
    muros:
    - nombre: Pilotaje proa
      a: {x: -4.1, y: 5.1}
      b: {x: 4.1, y: 5.1}
      huecos: []
    - nombre: Pilotaje derecha
