  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PrototipoMision.HudMinimo
  energia: {fileID: 53977}
  sonda: {fileID: 53976}
  estacion: {fileID: 1317976970}
  titulo: "ENERG\xCDA DE LA SONDA"
  etiquetaDemo: "VALORES DE DEMOSTRACI\xD3N \xB7 no son datos cient\xEDficos"
  textoCargando: "En la estaci\xF3n: recargando"
  textoFuera: "Fuera de la estaci\xF3n"
  textoUnidades: "W (vatio) = consumo en cada instante \xB7 Wh (vatio-hora) = energ\xEDa
    guardada.\n1 s real = {0:0.#} min de misi\xF3n."
  textoTeclas: "WASD mover \xB7 Espacio subir \xB7 Ctrl/C bajar \xB7 Shift turbo
    \xB7 Rat\xF3n mirar \xB7 E escanear \xB7 F cerrar ficha \xB7 T terminar (en la
    estaci\xF3n) \xB7 M configuraci\xF3n \xB7 F9 rendimiento \xB7 Esc liberar cursor"
  textoAgotada: "ENERG\xCDA AGOTADA\nLa sonda no puede moverse ni volver a la estaci\xF3n.\nPulsa
    R para reiniciar."
  textoAgotadaConInforme: "ENERG\xCDA AGOTADA\nLa sonda no puede moverse ni volver
    a la estaci\xF3n.\nGenerando el informe de la misi\xF3n\u2026"
